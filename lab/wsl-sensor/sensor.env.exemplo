# Configuracao do sensor Suricata na WSL (rede espelhada). Copie para
# `sensor.env` (ignorado pelo git) e preencha a chave.

# A API corre no Windows host. Em rede espelhada, a WSL partilha o localhost
# com o Windows -- 127.0.0.1 chega mesmo assim a API. Se nao chegar, use o IP
# da LAN (o mesmo em ambos, por ser rede espelhada): 192.168.18.116.
SHEISA_HOOK_URL=http://127.0.0.1:8099/api/ingest/suricata

# Chave de ingestao do tipo SURICATA, criada na maquina central com:
#   cd backend && ./.venv/Scripts/python.exe -m scripts.manage \
#     create-api-key --name "Sensor WSL (rede espelhada)" --kind SURICATA
SHEISA_API_KEY=cole-aqui-a-chave-de-ingestao
