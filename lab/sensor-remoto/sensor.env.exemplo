# Configuração do sensor Suricata remoto. Copie para `sensor.env` e preencha.
# `sensor.env` é ignorado pelo git (contém a chave em claro).

# Onde entregar os alertas: a API da SHEISA na máquina central. Troque o IP pelo
# da máquina que corre a plataforma (nesta instalação: 192.168.18.116).
SHEISA_HOOK_URL=http://192.168.18.116:8099/api/ingest/suricata

# Chave de ingestão do tipo SURICATA. Crie uma na máquina central com:
#   cd backend && ./.venv/Scripts/python.exe -m scripts.manage \
#     create-api-key --name "Sensor da maquina X" --kind SURICATA
# A chave só é mostrada uma vez. Cada sensor deve ter a sua, para a origem de
# cada alerta ser atribuível e revogável isoladamente.
SHEISA_API_KEY=cole-aqui-a-chave-de-ingestao

# Interface de rede a vigiar no anfitrião. Descubra com `ip -o link show`.
SURICATA_IFACE=eth0
