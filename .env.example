# ====================================================================
# SHEISA — configuração local. NÃO versionar (ver .gitignore).
# Segredos gerados automaticamente com secrets.token_urlsafe.
# ====================================================================
POSTGRES_USER=sheisa
POSTGRES_PASSWORD=altere-me
POSTGRES_DB=sheisa
POSTGRES_PORT=15433
POSTGRES_TEST_PORT=15434

SHEISA_DATABASE_URL=postgresql+asyncpg://sheisa:altere-me@127.0.0.1:15433/sheisa
SHEISA_TEST_DATABASE_URL=postgresql+asyncpg://sheisa:altere-me@127.0.0.1:15434/sheisa_test

SHEISA_JWT_SECRET=gere-com-python-c-import-secrets-print-secrets-token_urlsafe-48
SHEISA_ENVIRONMENT=development
SHEISA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SHEISA_EVIDENCE_STORAGE_PATH=./var/evidence
