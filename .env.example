# ====================================================================
# SHEISA — configuração local. NÃO versionar (ver .gitignore).
# Segredos gerados automaticamente com secrets.token_urlsafe.
# ====================================================================
POSTGRES_USER=sheisa
POSTGRES_PASSWORD=altere-me
POSTGRES_DB=sheisa
POSTGRES_PORT=15433
POSTGRES_TEST_PORT=15434

SHEISA_DATABASE_URL=postgresql+asyncpg://sheisa:altere-me@127.0.0.1:15433/sheisa
SHEISA_TEST_DATABASE_URL=postgresql+asyncpg://sheisa:altere-me@127.0.0.1:15434/sheisa_test

SHEISA_JWT_SECRET=gere-com-python-c-import-secrets-print-secrets-token_urlsafe-48
SHEISA_ENVIRONMENT=development
SHEISA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SHEISA_EVIDENCE_STORAGE_PATH=./var/evidence

# ------------------------------------------------- correio electrónico (§37)
# O canal de email tem duas direcções e as duas precisam de configuração: a
# plataforma **envia** o aviso de recepção por SMTP e **lê** as comunicações que
# chegam à caixa de segurança por POP3.
#
# Sem estas variáveis o canal fica NAO_CONFIGURADA e não é apresentado como
# funcional em lado nenhum — nunca se finge um envio (§4).
#
# Em desenvolvimento apontam para o contentor `mail` (Mailpit), que faz as duas
# coisas e mostra as mensagens em http://127.0.0.1:8025. Numa instalação real
# apontam para o servidor da organização; o código é o mesmo.
SHEISA_SMTP_HOST=127.0.0.1
SHEISA_SMTP_PORT=1025
SHEISA_SMTP_USER=
SHEISA_SMTP_PASSWORD=
SHEISA_SMTP_STARTTLS=false
# Endereço que aparece como remetente, e para onde as respostas vão.
SHEISA_MAIL_FROM=cert@sheisa.local
SHEISA_MAIL_FROM_NAME=Equipa de Resposta a Incidentes

# Caixa de segurança que a plataforma lê para recolher comunicações.
#
# O protocolo escolhe-se aqui. Em desenvolvimento (Mailpit) é POP3; um servidor
# real como o Gmail usa IMAP. As credenciais (USER/PASSWORD) são as mesmas para
# os dois protocolos — é a mesma conta.
SHEISA_MAIL_COLLECT_PROTOCOL=POP3
SHEISA_POP3_HOST=127.0.0.1
SHEISA_POP3_PORT=1110
SHEISA_POP3_USER=cert@sheisa.local
SHEISA_POP3_PASSWORD=altere-me
SHEISA_POP3_TLS=false
SHEISA_IMAP_HOST=
SHEISA_IMAP_PORT=993
SHEISA_IMAP_TLS=true

# Portas expostas pelo contentor de correio em desenvolvimento.
SHEISA_MAIL_UI_PORT=8025

# --- Exemplo de configuração com Gmail (servidor real) -----------------------
# Descomente e preencha para usar uma conta Gmail em vez do Mailpit. Requer:
#   1. Verificação em duas etapas ACTIVADA na conta Google.
#   2. Uma "palavra-passe de aplicação" de 16 caracteres, gerada em
#      https://myaccount.google.com/apppasswords — NÃO é a palavra-passe normal.
# A palavra-passe de aplicação é um segredo: vive só aqui, nunca no código.
#
# SHEISA_SMTP_HOST=smtp.gmail.com
# SHEISA_SMTP_PORT=587
# SHEISA_SMTP_STARTTLS=true
# SHEISA_SMTP_USER=cert.exemplo@gmail.com
# SHEISA_SMTP_PASSWORD=as16letrasdaapppassword
# SHEISA_MAIL_FROM=cert.exemplo@gmail.com
# SHEISA_MAIL_COLLECT_PROTOCOL=IMAP
# SHEISA_IMAP_HOST=imap.gmail.com
# SHEISA_IMAP_PORT=993
# SHEISA_IMAP_TLS=true
# SHEISA_POP3_USER=cert.exemplo@gmail.com
# SHEISA_POP3_PASSWORD=as16letrasdaapppassword
